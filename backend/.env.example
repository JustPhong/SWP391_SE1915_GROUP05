# Environment variables for Parking System Backend

# SQL Server connection string
# Example: sqlserver://localhost:1433;database=parking_system;user=sa;password=YourPassword;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=parking_system;user=sa;password=YourPassword;trustServerCertificate=true"

# JWT secret for authentication
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# Server port (optional, defaults to 3000)
PORT=3000

# VietQR Configuration (Thay đổi bằng thông tin ngân hàng của bạn)
VIETQR_BANK_ID="MB"
VIETQR_ACCOUNT_NO="0000000000"
VIETQR_ACCOUNT_NAME="PARKSMART OWNER"

